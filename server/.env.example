# LocalPulse Server — Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5175

# ─── Database ─────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/localpulse"

# ─── JWT ──────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_64_chars_minimum
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_64_chars_minimum
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Session / Cookies ────────────────────────────
COOKIE_SECRET=CHANGE_ME_cookie_secret_32_chars_minimum
COOKIE_SECURE=false         # Set to true in production (HTTPS only)
COOKIE_SAME_SITE=lax

# ─── File Uploads ─────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_POST=4

# ─── Rate Limiting ────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX_GENERAL=100
RATE_LIMIT_MAX_AUTH=10        # Stricter for login/register

# ─── Moderation Thresholds (configurable) ─────────
REPORT_THRESHOLD_FLAG=1       # 1 report  → record
REPORT_THRESHOLD_RECONFIRM=2  # 2 reports → flag + request reconfirmation
REPORT_THRESHOLD_REVIEW=3     # 3 reports in 48h → Needs Review
REPORT_WINDOW_HOURS=48

# ─── Category Proposals ───────────────────────────
CATEGORY_PROPOSAL_LIMIT_DAYS=30
CATEGORY_PROPOSAL_MAX_PER_WINDOW=2
CATEGORY_MAX_CUSTOM_PER_COMMUNITY=5
CATEGORY_PROPOSAL_REQUIRED_SUPPORT=3

# ─── Post Expiry ──────────────────────────────────
POST_DEFAULT_EXPIRY_DAYS=30
